{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "typecheck": "vue-tsc --noEmit",
        "test:browser": "playwright test",
        "format": "prettier --write resources/js resources/css vite.config.js playwright.config.ts tests/browser scripts",
        "benchmark": "node scripts/benchmark-panel.mjs"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.0.0",
        "typescript": "~5.9.3",
        "vite": "^8.0.0",
        "vue-tsc": "^3.3.12"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.8.0",
        "vue": "^3.5.43"
    },
    "engines": {
        "node": ">=22.12"
    }
